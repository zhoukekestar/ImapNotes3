<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/ActionBgColor">
<ScrollView
    android:id="@+id/scrollView"
    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:fillViewport="true" android:clipToPadding="false"
    android:background="@color/ActionBgColor">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="16dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="20dp">
            <ImageView android:id="@+id/accountHeaderIcon" android:layout_width="52dp" android:layout_height="52dp"
                android:src="@drawable/ic_notes_empty" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:layout_marginStart="16dp">
                <TextView android:id="@+id/heading" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/account_connect_title" android:textSize="24sp"
                    android:fontFamily="sans-serif-medium" android:textColor="@color/ActionTxtColor" />
                <TextView android:id="@+id/accountSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/account_connect_body" android:textSize="14sp" android:lineSpacingExtra="3dp"
                    android:textColor="@color/secondaryText" android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/googleAuthControls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">
            <com.google.android.material.button.MaterialButton android:id="@id/googleChooseAccount"
                style="@style/AccountGoogleButton" android:text="@string/account_google_continue"
                app:icon="@drawable/ic_google" app:iconSize="20dp" app:iconPadding="12dp" app:iconGravity="textStart" />
        </LinearLayout>
        <LinearLayout android:id="@+id/emailDivider" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp" android:layout_marginBottom="20dp">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/outline" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" android:text="@string/account_or_email" android:textSize="12sp" android:textColor="@color/secondaryText" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/outline" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp" android:background="@drawable/account_surface">
            <TextView android:id="@+id/credentialsTitle" style="@style/AccountSectionTitle" android:text="@string/account_email_login" />
            <TextView android:id="@+id/credentialsSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/account_email_support" android:textSize="12sp" android:textColor="@color/secondaryText" android:layout_marginTop="6dp" />
            <LinearLayout android:id="@+id/googleSelectedAccount" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="16dp" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_google_selected"
                    android:textSize="12sp" android:textColor="@color/secondaryText" />
                <TextView android:id="@+id/googleSelectedEmail" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="16sp" android:textColor="@color/ActionTxtColor" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/usernameInput" style="@style/AccountInput"
                android:hint="@string/email_address">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/usernameEdit" style="@style/AccountEditText"
                    android:autofillHints="username" android:inputType="textEmailAddress" android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordInput" style="@style/AccountInput"
                android:hint="@string/password" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/passwordEdit" style="@style/AccountEditText"
                    android:autofillHints="password" android:inputType="textPassword" android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/providerHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/secondaryText" android:textSize="12sp" android:lineSpacingExtra="3dp"
                android:visibility="gone" android:layout_marginTop="14dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/authorizationHelp" style="@style/AccountTextButton"
                android:layout_width="wrap_content" android:text="@string/authorization_code_help" android:visibility="gone"
                android:paddingStart="0dp" android:paddingEnd="8dp" android:insetLeft="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/useEmailLogin" style="@style/AccountTextButton"
                android:layout_width="wrap_content" android:text="@string/account_use_email" android:visibility="gone"
                android:paddingStart="0dp" android:paddingEnd="8dp" android:insetLeft="0dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="16dp" android:background="@drawable/account_surface">
            <LinearLayout android:id="@+id/BtnExpandAccountSettings" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="76dp" android:padding="20dp" android:gravity="center_vertical" android:orientation="horizontal"
                android:background="?attr/selectableItemBackground" android:focusable="true" android:clickable="true">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/AccountSectionTitle" android:text="@string/account_sync_settings" />
                    <TextView android:id="@+id/accountSettingsSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/account_sync_defaults" android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="@color/secondaryText" />
                </LinearLayout>
                <ImageView android:id="@+id/accountSettingsChevron" android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_marginStart="12dp" android:src="@drawable/ic_chevron_down" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/ViewExtendedAccountSettings" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="20dp" android:orientation="vertical" android:visibility="gone">
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/outline" android:layout_marginBottom="20dp" />
                <TextView style="@style/AccountSectionTitle" android:text="@string/account_server_settings" />
                <com.google.android.material.textfield.TextInputLayout style="@style/AccountInput" android:hint="@string/account_name">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/accountnameEdit" style="@style/AccountEditText"
                        android:importantForAutofill="no" android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/AccountInput" android:hint="@string/server">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/serverEdit" style="@style/AccountEditText"
                        android:inputType="textNoSuggestions|textVisiblePassword" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:text="@string/security" android:textSize="12sp" android:textColor="@color/secondaryText" android:labelFor="@id/securitySpinner" />
                <Spinner android:id="@+id/securitySpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
                <com.google.android.material.textfield.TextInputLayout style="@style/AccountInput" android:hint="@string/port_number">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/portnumEdit" style="@style/AccountEditText" android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView style="@style/AccountSectionTitle" android:layout_marginTop="28dp" android:text="@string/account_note_settings" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:text="@string/sync_interval" android:textSize="12sp" android:textColor="@color/secondaryText" android:labelFor="@id/syncintervalSpinner" />
                <Spinner android:id="@+id/syncintervalSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
                <com.google.android.material.textfield.TextInputLayout style="@style/AccountInput" android:hint="@string/account_notes_folder">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/folderEdit" style="@style/AccountEditText" android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/copyImapFolder" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:checked="false" android:text="@string/copyImapFolderName" />
                <com.google.android.material.textfield.TextInputLayout style="@style/AccountInput" android:hint="@string/account_backup_folder">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/copyImapFolderName" style="@style/AccountEditText" android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/removeAccountSection" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="vertical" android:visibility="gone">
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/outline" android:layout_marginBottom="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/removeAccountButton" style="@style/AccountTextButton"
                android:text="@string/account_remove_button" android:textColor="@color/syncError" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_remove_body"
                android:textSize="12sp" android:textColor="@color/secondaryText" android:gravity="center" android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
    <LinearLayout android:id="@+id/accountActions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="12dp" android:paddingBottom="16dp" android:background="@color/ActionBgColor">
        <LinearLayout android:id="@+id/loginProgressPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/account_surface"
            android:visibility="gone" android:layout_marginBottom="12dp">
            <com.google.android.material.progressindicator.CircularProgressIndicator android:layout_width="32dp" android:layout_height="32dp"
                android:indeterminate="true" app:indicatorSize="28dp" app:trackThickness="3dp" />
            <TextView android:id="@+id/loginProgressText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp" android:text="@string/login_connecting" android:textColor="@color/ActionTxtColor"
                android:textSize="14sp" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <LinearLayout android:id="@+id/buttonsLayout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@id/accountCancelButton" style="@style/AccountTextButton"
                android:layout_width="wrap_content" android:minWidth="72dp" android:layout_marginEnd="12dp"
                android:text="@string/cancel" android:textColor="@color/secondaryText" />
            <com.google.android.material.button.MaterialButton android:id="@id/accountLoginButton" style="@style/AccountPrimaryButton"
                android:layout_width="0dp" android:layout_weight="1" android:text="@string/account_connect_button" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
