<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/EditorBgColorDefault">
  <LinearLayout
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical"
      android:paddingStart="20dp" android:paddingEnd="12dp"
      android:background="@color/EditorMenuBgColor">
    <TextView android:id="@+id/editorStatus" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:text="@string/editor_loading" android:textSize="14sp"
        android:textColor="@color/secondaryText" />
    <com.google.android.material.button.MaterialButton android:id="@+id/editorModeButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/editor_edit"
        android:textAllCaps="false" android:enabled="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/editorFormatBar" android:orientation="vertical"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:background="@color/EditorMenuBgColor" android:paddingStart="16dp"
      android:paddingEnd="16dp" android:paddingBottom="8dp">
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/editorFormats"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/editorRich">
      <com.google.android.material.button.MaterialButton android:id="@+id/editorRich"
          style="@style/EditorFormatButton" android:text="@string/editor_rich" />
      <com.google.android.material.button.MaterialButton android:id="@+id/editorHtml"
          style="@style/EditorFormatButton" android:text="HTML" />
      <com.google.android.material.button.MaterialButton android:id="@+id/editorMarkdown"
          style="@style/EditorFormatButton" android:text="Markdown" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <com.google.android.material.button.MaterialButton android:id="@+id/editorPreview"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:minHeight="48dp"
        android:text="@string/editor_preview" android:textAllCaps="false" android:visibility="gone" />
  </LinearLayout>
  <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/editorProgress"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" />
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <jp.wasabeef.richeditor.RichEditor android:id="@+id/bodyView"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/editorSource"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" android:gravity="top|start"
        android:saveEnabled="false"
        android:padding="20dp" android:background="@android:color/transparent"
        android:textColor="@color/EditorTxtColor" android:textSize="15sp"
        android:fontFamily="monospace" android:inputType="textMultiLine|textNoSuggestions"
        android:imeOptions="flagNoExtractUi" android:scrollbars="vertical" />
  </FrameLayout>
  <HorizontalScrollView
      android:id="@+id/editorTools"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/EditorMenuBgColor"
      android:gravity="bottom">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
      <ImageButton
          android:id="@+id/action_undo"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:background="@color/EditorMenuBgColor"
          android:contentDescription="@string/undo"
          android:src="@drawable/undo"
          app:tint="@color/EditorTxtColor" />
      <ImageButton
          android:id="@+id/action_redo"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:background="@color/EditorMenuBgColor"
          android:contentDescription="@string/redo"
          android:src="@drawable/redo"
          app:tint="@color/EditorTxtColor" />
      <de.niendo.ImapNotes3.Miscs.NDSpinner
          android:id="@+id/action_format"
          android:layout_width="fill_parent"
          android:layout_height="wrap_content"
          android:background="@color/EditorMenuBgColor"
          android:contentDescription="@string/format"
          android:minHeight="48dp"
          android:title="@string/format" />
      <de.niendo.ImapNotes3.Miscs.NDSpinner
          android:id="@+id/action_insert"
          android:layout_width="fill_parent"
          android:layout_height="wrap_content"
          android:background="@color/EditorMenuBgColor"
          android:contentDescription="@string/insert"
          android:minHeight="48dp"
          android:title="@string/insert" />
      <de.niendo.ImapNotes3.Miscs.NDSpinner
          android:id="@+id/action_heading"
          android:layout_width="fill_parent"
          android:layout_height="wrap_content"
          android:background="@color/EditorMenuBgColor"
          android:contentDescription="@string/heading"
          android:minHeight="48dp"
          android:title="@string/heading" />
      <de.niendo.ImapNotes3.Miscs.NDSpinner
          android:id="@+id/action_alignment"
          android:layout_width="fill_parent"
          android:layout_height="wrap_content"
          android:background="@color/EditorMenuBgColor"
          android:contentDescription="@string/alignment"
          android:minHeight="48dp"
          android:title="@string/alignment" />
      <de.niendo.ImapNotes3.Miscs.NDSpinner
          android:id="@+id/action_table"
          android:layout_width="fill_parent"
          android:layout_height="wrap_content"
          android:background="@color/EditorMenuBgColor"
          android:contentDescription="@string/table"
          android:minHeight="48dp"
          android:title="@string/table" />
    </LinearLayout>
  </HorizontalScrollView>
</LinearLayout>
