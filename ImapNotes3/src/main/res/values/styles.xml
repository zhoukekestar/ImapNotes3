<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="ImapNotesThemeBase" parent="Theme.Material3.DayNight">
        <item name="android:windowBackground">@color/ActionBgColor</item>
        <item name="android:colorBackground">@color/ActionBgColor</item>
        <item name="android:colorForeground">@color/ActionTxtColor</item>
        <item name="android:textColorPrimary">@color/ActionTxtColor</item>
        <item name="android:textColorSecondary">@color/secondaryText</item>
        <item name="android:textColorHint">@color/AccountHintColor</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/onAccent</item>
        <item name="colorPrimaryContainer">@color/accentSoft</item>
        <item name="colorOnPrimaryContainer">@color/ActionTxtColor</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/ActionTxtColor</item>
        <item name="colorOnSurfaceVariant">@color/secondaryText</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorAccent">@color/accent</item>
        <item name="actionBarStyle">@style/MyActionBar</item>
        <item name="android:statusBarColor">@color/ActionBgColor</item>
        <item name="android:navigationBarColor">@color/ActionBgColor</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
    <style name="MyActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/ActionBgColor</item>
        <item name="titleTextStyle">@style/MyActionBar.TitleTextStyle</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="MyActionBar.TitleTextStyle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/ActionTxtColor</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="ImapNotesTheme" parent="ImapNotesThemeBase" />
</resources>
